{
  "dashboard": {
    "id": null,
    "uid": "infrastructure-dashboard",
    "title": "Infrastructure Dashboard",
    "tags": ["opendesk", "infrastructure", "nodes", "resources"],
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "type": "text",
        "title": "Infrastructure Overview",
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
        "options": {
          "content": "<div style='background: linear-gradient(90deg, #0a0014 0%, #571EFA 50%, #927AFA 100%); padding: 20px; border-radius: 5px;'>\n  <h2 style='color: white; margin: 0; text-align: center;'>\n    <i class='fas fa-server' style='color: #DDD6FE; font-size: 40px; vertical-align: middle;'></i>\n    &nbsp; Infrastructure Monitoring
  </h2>\n  <p style='color: #DDD6FE; margin: 10px 0 0 0; text-align: center; font-size: 14px;'>\n    K3s cluster nodes, resources, and infrastructure health\n  </p>\n</div>",
          "mode": "html"
        }
      },
      {
        "type": "row",
        "title": "Cluster Summary",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
        "collapsed": false
      },
      {
        "type": "stat",
        "title": "Total Nodes",
        "gridPos": { "h": 8, "w": 4, "x": 0, "y": 5 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "count(kube_node_info)",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Ready Nodes",
        "gridPos": { "h": 8, "w": 4, "x": 4, "y": 5 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 0 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "count(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Not Ready Nodes",
        "gridPos": { "h": 8, "w": 4, "x": 8, "y": 5 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 1 },
                { "color": "red", "value": 3 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "count(kube_node_status_condition{condition=\"Ready\",status=\"false\"})",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Total Pods",
        "gridPos": { "h": 8, "w": 4, "x": 12, "y": 5 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(kube_pod_info)",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Running Pods",
        "gridPos": { "h": 8, "w": 4, "x": 16, "y": 5 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(kube_pod_status_phase{phase=\"Running\"})",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Cluster Uptime",
        "gridPos": { "h": 8, "w": 4, "x": 20, "y": 5 },
        "fieldConfig": {
          "defaults": {
            "unit": "dtdur",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 86400 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "max(kube_node_status_boot_id)",
            "instant": true
          }
        ]
      },
      {
        "type": "row",
        "title": "Node Resources",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
        "collapsed": false
      },
      {
        "type": "graph",
        "title": "Node CPU Usage",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Node Memory Usage",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "((node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes) * 100",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Node Disk Usage",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "((node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_free_bytes{mountpoint=\"/\"}) / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Node Disk I/O",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "rate(node_disk_io_time_seconds_total[5m]) * 100",
            "legendFormat": "{{instance}} - {{device}}"
          }
        ]
      },
      {
        "type": "row",
        "title": "Node Details",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
        "collapsed": true
      },
      {
        "type": "graph",
        "title": "Node CPU Steal",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 31 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "rate(node_cpu_seconds_total{mode=\"steal\"}[5m]) * 100",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Node Load Average",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 31 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "node_load1",
            "legendFormat": "1m - {{instance}}"
          },
          {
            "expr": "node_load5",
            "legendFormat": "5m - {{instance}}"
          },
          {
            "expr": "node_load15",
            "legendFormat": "15m - {{instance}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Node Memory (Used vs Cached)",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 31 },
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Used"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#571EFA",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Cached"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#927AFA",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "targets": [
          {
            "expr": "node_memory_MemTotal_bytes - node_memory_MemFree_bytes - node_memory_Buffers_bytes - node_memory_Cached_bytes",
            "legendFormat": "Used"
          },
          {
            "expr": "node_memory_Cached_bytes",
            "legendFormat": "Cached"
          }
        ]
      },
      {
        "type": "row",
        "title": "Node Network",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
        "collapsed": true
      },
      {
        "type": "graph",
        "title": "Node Network RX",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
        "fieldConfig": {
          "defaults": {
            "unit": "Bps",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "rate(node_network_receive_bytes_total{device!~\"lo|bond.*\"}[5m])",
            "legendFormat": "{{instance}} - {{device}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Node Network TX",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
        "fieldConfig": {
          "defaults": {
            "unit": "Bps",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|bond.*\"}[5m])",
            "legendFormat": "{{instance}} - {{device}}"
          }
        ]
      },
      {
        "type": "row",
        "title": "Kubernetes Resources",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
        "collapsed": false
      },
      {
        "type": "graph",
        "title": "Pod Resource Requests",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Requested CPU"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#571EFA",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Requested Memory"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#927AFA",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "targets": [
          {
            "expr": "sum(kube_pod_container_resource_requests{resource=\"cpu\"}) by (namespace)",
            "legendFormat": "Requested CPU - {{namespace}}"
          },
          {
            "expr": "sum(kube_pod_container_resource_requests{resource=\"memory\"}) by (namespace)",
            "legendFormat": "Requested Memory - {{namespace}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Pod Resource Limits",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 49 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Limit CPU"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#571EFA",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Limit Memory"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#927AFA",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "targets": [
          {
            "expr": "sum(kube_pod_container_resource_limits{resource=\"cpu\"}) by (namespace)",
            "legendFormat": "Limit CPU - {{namespace}}"
          },
          {
            "expr": "sum(kube_pod_container_resource_limits{resource=\"memory\"}) by (namespace)",
            "legendFormat": "Limit Memory - {{namespace}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Container FS Usage",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(container_fs_usage_bytes{container!=\"\"}) by (pod)",
            "legendFormat": "{{pod}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Container Restarts",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 57 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none"
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "topk(10, increase(kube_pod_container_status_restarts_total[1h]))",
            "legendFormat": "{{pod}} - {{container}}"
          }
        ]
      },
      {
        "type": "row",
        "title": "Node Health",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 65 },
        "collapsed": true
      },
      {
        "type": "graph",
        "title": "Node Disk Free Space",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 66 },
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "node_filesystem_free_bytes{mountpoint=\"/\"}",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Node Systemd Service State",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 66 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "node_systemd_unit_state{state=\"running\"}",
            "legendFormat": "Running - {{name}} - {{instance}}"
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "current": {
            "selected": false,
            "text": "",
            "value": ""
          },
          "hide": 0,
          "includeAll": false,
          "multi": false,
          "name": "datasource",
          "options": [],
          "query": "prometheus",
          "queryValue": "",
          "refresh": 1,
          "regex": "",
          "skipUrlSync": false,
          "type": "datasource"
        },
        {
          "current": {
            "selected": false,
            "text": "All",
            "value": ".*"
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "definition": "label_values(kube_node_info, instance)",
          "hide": 0,
          "includeAll": true,
          "label": "Node",
          "multi": true,
          "name": "node",
          "options": [],
          "query": "label_values(kube_node_info, instance)",
          "refresh": 1,
          "regex": ".*",
          "skipUrlSync": false,
          "type": "query"
        },
        {
          "current": {
            "selected": false,
            "text": "All",
            "value": ".*"
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "definition": "label_values(kube_namespace_labels, namespace)",
          "hide": 0,
          "includeAll": true,
          "label": "Namespace",
          "multi": true,
          "name": "namespace",
          "options": [],
          "query": "label_values(kube_namespace_labels, namespace)",
          "refresh": 1,
          "regex": ".*",
          "skipUrlSync": false,
          "type": "query"
        }
      ]
    },
    "schemaVersion": 30,
    "style": "dark",
    "tags": ["opendesk", "infrastructure", "nodes"],
    "time": { "from": "now-1h", "to": "now" },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "timezone": "",
    "title": "Infrastructure Dashboard",
    "version": 1
  },
  "folderId": 0,
  "overwrite": true
}
