{
  "dashboard": {
    "id": null,
    "uid": "opendesk-overview",
    "title": "openDesk Overview",
    "tags": ["opendesk", "overview"],
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "type": "stat",
        "title": "System Health",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": { "text": "Down" },
                  "1": { "text": "Up" }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "avg(up)",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Dev Agent Status",
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": { "text": "Down" },
                  "1": { "text": "Up" }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "up{job=\"dev-agent\"}",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "SOGo 5 Status",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": { "text": "Down" },
                  "1": { "text": "Up" }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "probe_success{job=\"blackbox\",instance=~\"sogo5.*\"}",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "SOGo 6 Status",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": { "text": "Down" },
                  "1": { "text": "Up" }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "probe_success{job=\"blackbox\",instance=~\"sogo6.*\"}",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Zot Registry Status",
        "gridPos": { "h": 8, "w": 6, "x": 24, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": { "text": "Down" },
                  "1": { "text": "Up" }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "probe_success{job=\"blackbox\",instance=~\"zot-registry.*\"}",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Active Repairs",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 5 },
                { "color": "red", "value": 10 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(increase(dev_agent_repairs_total[1m]))",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Healthy Components",
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "dev_agent:components_healthy",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Degraded Components",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 1 },
                { "color": "red", "value": 3 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "dev_agent:components_degraded",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Failed Components",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "dev_agent:components_failed",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Repair Success Rate",
        "gridPos": { "h": 8, "w": 6, "x": 24, "y": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 90 },
                { "color": "green", "value": 95 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "dev_agent:repair_success_rate:5m * 100",
            "instant": true
          }
        ]
      },
      {
        "type": "graph",
        "title": "Repairs Over Time",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "axes": {
                "y": [
                  { "scale": "linear" }
                ]
              }
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "rate(dev_agent_repairs_total[1m])",
            "legendFormat": "Repairs"
          },
          {
            "expr": "rate(dev_agent_repair_failures_total[1m])",
            "legendFormat": "Failures"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Repair Duration",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "axes": {
                "y": [
                  { "scale": "linear" }
                ]
              }
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "dev_agent:repair_duration_seconds:p50",
            "legendFormat": "P50"
          },
          {
            "expr": "dev_agent:repair_duration_seconds:p95",
            "legendFormat": "P95"
          },
          {
            "expr": "dev_agent:repair_duration_seconds:p99",
            "legendFormat": "P99"
          }
        ]
      },
      {
        "type": "graph",
        "title": "SOGo 5 Resource Usage",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sogo5:container:cpu_usage_percent",
            "legendFormat": "CPU"
          },
          {
            "expr": "sogo5:container:memory_usage_percent",
            "legendFormat": "Memory"
          }
        ]
      },
      {
        "type": "graph",
        "title": "SOGo 6 Resource Usage",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sogo6:container:cpu_usage_percent",
            "legendFormat": "CPU"
          },
          {
            "expr": "sogo6:container:memory_usage_percent",
            "legendFormat": "Memory"
          }
        ]
      },
      {
        "type": "graph",
        "title": "SOGo 6 Storage Usage",
        "gridPos": { "h": 8, "w": 12, "x": 24, "y": 24 },
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "custom": {
              "axes": {
                "y": [
                  { "scale": "linear" }
                ]
              }
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Used"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#C4162A",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Available"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#119600",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "targets": [
          {
            "expr": "sogo6:storage:used_bytes",
            "legendFormat": "Used"
          },
          {
            "expr": "sogo6:storage:available_bytes",
            "legendFormat": "Available"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Zot Registry Cache Performance",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "zot:cache:hit_ratio:5m * 100",
            "legendFormat": "Cache Hit Ratio"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Zot Registry Storage",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "custom": {
              "axes": {
                "y": [
                  { "scale": "linear" }
                ]
              }
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "zot:storage:total_bytes",
            "legendFormat": "Total"
          },
          {
            "expr": "zot:storage:manifests_count",
            "legendFormat": "Manifests",
            "unit": "short"
          },
          {
            "expr": "zot:storage:blobs_count",
            "legendFormat": "Blobs",
            "unit": "short"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Node Resource Usage",
        "gridPos": { "h": 8, "w": 12, "x": 24, "y": 32 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "node:cpu:usage:5m",
            "legendFormat": "CPU"
          },
          {
            "expr": "node:memory:usage_percent",
            "legendFormat": "Memory"
          }
        ]
      },
      {
        "type": "graph",
        "title": "MariaDB Connections",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Used"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#C4162A",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Max"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#3788d8",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "targets": [
          {
            "expr": "mariadb:connections:active",
            "legendFormat": "Used"
          },
          {
            "expr": "mariadb:connections:max",
            "legendFormat": "Max"
          }
        ]
      },
      {
        "type": "graph",
        "title": "MariaDB Query Performance",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "mariadb:queries:total:5m_rate",
            "legendFormat": "Total"
          },
          {
            "expr": "mariadb:queries:slow:5m_rate",
            "legendFormat": "Slow"
          },
          {
            "expr": "mariadb:queries:errors:5m_rate",
            "legendFormat": "Errors"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Memcached Performance",
        "gridPos": { "h": 8, "w": 12, "x": 24, "y": 40 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Hit Ratio"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percent"
                }
              ]
            }
          ]
        },
        "targets": [
          {
            "expr": "memcached:operations:hit_ratio * 100",
            "legendFormat": "Hit Ratio"
          },
          {
            "expr": "memcached:operations:hits:5m_rate",
            "legendFormat": "Hits/5m"
          },
          {
            "expr": "memcached:operations:misses:5m_rate",
            "legendFormat": "Misses/5m"
          },
          {
            "expr": "memcached:operations:evictions:5m_rate",
            "legendFormat": "Evictions/5m"
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "current": {
            "selected": false,
            "text": "",
            "value": ""
          },
          "hide": 0,
          "includeAll": false,
          "multi": false,
          "name": "datasource",
          "options": [],
          "query": "prometheus",
          "queryValue": "",
          "refresh": 1,
          "regex": "",
          "skipUrlSync": false,
          "type": "datasource"
        }
      ]
    },
    "schemaVersion": 30,
    "style": "dark",
    "tags": ["opendesk", "overview"],
    "time": { "from": "now-1h", "to": "now" },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "timezone": "",
    "title": "openDesk Overview",
    "version": 1,
    "weekStart": ""
  },
  "folderId": 0,
