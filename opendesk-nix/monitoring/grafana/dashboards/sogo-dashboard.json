{
  "dashboard": {
    "id": null,
    "uid": "sogo-dashboard",
    "title": "SOGo Services Dashboard",
    "tags": ["opendesk", "sogo", "email", "calendar"],
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "type": "text",
        "title": "SOGo Overview",
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
        "options": {
          "content": "<div style='background: linear-gradient(90deg, #0a0014 0%, #571EFA 50%, #927AFA 100%); padding: 20px; border-radius: 5px;'>\n  <h2 style='color: white; margin: 0; text-align: center;'>\n    <img src='https://opendesk-edu.org/static/logo.svg' style='height: 40px; vertical-align: middle;' />\n    &nbsp; SOGo Mail & Calendar Services
  </h2>\n</div>",
          "mode": "html"
        }
      },
      {
        "type": "stat",
        "title": "SOGo 5 Status",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 4 },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": { "text": "Down", "color": "red" },
                  "1": { "text": "Up", "color": "green" }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "probe_success{job=\"blackbox\",instance=~\"sogo5.*\"}",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "SOGo 5 CPU Usage",
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 4 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 70 },
                { "color": "red", "value": 85 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sogo5:container:cpu_usage_percent",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "SOGo 5 Memory Usage",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 4 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 75 },
                { "color": "red", "value": 85 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sogo5:container:memory_usage_percent",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "SOGo 5 Uptime (1h)",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 4 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 95 },
                { "color": "green", "value": 99 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sogo5:health:availability:1h * 100",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "SOGo 6 Status",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 12 },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": { "text": "Down", "color": "red" },
                  "1": { "text": "Up", "color": "green" }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "probe_success{job=\"blackbox\",instance=~\"sogo6.*\"}",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "SOGo 6 CPU Usage",
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 12 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 70 },
                { "color": "red", "value": 85 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sogo6:container:cpu_usage_percent",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "SOGo 6 Memory Usage",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 12 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 75 },
                { "color": "red", "value": 85 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sogo6:container:memory_usage_percent",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "SOGo 6 Storage Usage",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 12 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 70 },
                { "color": "red", "value": 85 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sogo6:storage:usage_percent",
            "instant": true
          }
        ]
      },
      {
        "type": "graph",
        "title": "SOGo 5 Resource Usage (CPU/Memory)",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "CPU"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#571EFA",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Memory"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#927AFA",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "targets": [
          {
            "expr": "sogo5:container:cpu_usage_percent",
            "legendFormat": "CPU - {{container_name}}"
          },
          {
            "expr": "sogo5:container:memory_usage_percent",
            "legendFormat": "Memory - {{container_name}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "SOGo 6 Resource Usage (CPU/Memory)",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "CPU"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#571EFA",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Memory"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#927AFA",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "targets": [
          {
            "expr": "sogo6:container:cpu_usage_percent",
            "legendFormat": "CPU - {{container_name}}"
          },
          {
            "expr": "sogo6:container:memory_usage_percent",
            "legendFormat": "Memory - {{container_name}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "SOGo 6 Storage - Used vs Available",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Used"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#C4162A",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Available"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#119600",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "targets": [
          {
            "expr": "sogo6:storage:used_bytes",
            "legendFormat": "Used"
          },
          {
            "expr": "sogo6:storage:available_bytes",
            "legendFormat": "Available"
          }
        ]
      },
      {
        "type": "graph",
        "title": "SOGo 6 Storage Usage %",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 70 },
                { "color": "red", "value": 85 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sogo6:storage:usage_percent",
            "legendFormat": "{{volume}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "SOGo HTTP Response Times (P50/P95)",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sogo5:http:request_duration_seconds:p50",
            "legendFormat": "SOGo5 - P50"
          },
          {
            "expr": "sogo5:http:request_duration_seconds:p95",
            "legendFormat": "SOGo5 - P95"
          }
        ]
      },
      {
        "type": "graph",
        "title": "SOGo Uptime History",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "SOGo 5"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#571EFA",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "SOGo 6"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#927AFA",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "targets": [
          {
            "expr": "sogo5:health:availability:5m * 100",
            "legendFormat": "SOGo 5"
          },
          {
            "expr": "sogo6:health:availability:5m * 100",
            "legendFormat": "SOGo 6"
          }
        ]
      },
      {
        "type": "graph",
        "title": "SOGo Container Restarts",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none"
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "increase(container_restarts_total{container_name=~\"sogo5.*|sogo6.*\"}[1h])",
            "legendFormat": "{{container_name}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "SOGo Network Traffic",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
        "fieldConfig": {
          "defaults": {
            "unit": "Bps",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "rate(container_network_receive_bytes_total{container_name=~\"sogo5.*\"}[1m])",
            "legendFormat": "SOGo5 - RX"
          },
          {
            "expr": "rate(container_network_transmit_bytes_total{container_name=~\"sogo5.*\"}[1m])",
            "legendFormat": "SOGo5 - TX"
          },
          {
            "expr": "rate(container_network_receive_bytes_total{container_name=~\"sogo6.*\"}[1m])",
            "legendFormat": "SOGo6 - RX"
          },
          {
            "expr": "rate(container_network_transmit_bytes_total{container_name=~\"sogo6.*\"}[1m])",
            "legendFormat": "SOGo6 - TX"
          }
        ]
      },
      {
        "type": "graph",
        "title": "SOGo Health Check Response Times",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 52 },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "probe_duration_seconds{job=\"blackbox\",instance=~\"sogo5.*|sogo6.*\"}",
            "legendFormat": "{{instance}}"
          }
        ]
      }
    ],
