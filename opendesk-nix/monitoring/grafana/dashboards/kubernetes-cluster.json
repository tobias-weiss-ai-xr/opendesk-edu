{
  "dashboard": {
    "id": null,
    "uid": "kubernetes-cluster-dashboard",
    "title": "Kubernetes Cluster Dashboard",
    "tags": ["opendesk", "kubernetes", "k3s", "cluster"],
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "type": "text",
        "title": "Kubernetes Cluster Overview",
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
        "options": {
          "content": "<div style='background: linear-gradient(90deg, #0a0014 0%, #571EFA 50%, #927AFA 100%); padding: 20px; border-radius: 5px;'>\n  <h2 style='color: white; margin: 0; text-align: center;'>\n    <i class='fas fa-cube' style='color: #DDD6FE; font-size: 40px; vertical-align: middle;'></i>\n    &nbsp; Kubernetes (K3s) Cluster Monitoring
  </h2>\n</div>",
          "mode": "html"
        }
      },
      {
        "type": "stat",
        "title": "Cluster Health",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 4 },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "1": { "text": "Healthy", "color": "green" }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "1",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Total Nodes",
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 4 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "count(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Ready Nodes",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 4 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 0 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "count(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Total Pods",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 4 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(kube_pod_status_phase) by (phase)",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Running Pods",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 12 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(kube_pod_status_phase{phase=\"Running\"})",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Pending Pods",
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 12 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 1 },
                { "color": "red", "value": 5 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(kube_pod_status_phase{phase=\"Pending\"})",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Failed Pods",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 12 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 1 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(kube_pod_status_phase{phase=\"Failed\"})",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Cluster CPU Usage",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 12 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 70 },
                { "color": "red", "value": 85 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Cluster Memory Usage",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 20 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 75 },
                { "color": "red", "value": 85 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "((node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes) * 100",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Cluster Storage Usage",
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 20 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 75 },
                { "color": "red", "value": 85 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "((node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_free_bytes{mountpoint=\"/\"}) / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100",
            "instant": true
          }
        ]
      },
      {
        "type": "graph",
        "title": "Pod Status Distribution",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "lineWidth": 0,
              "fillOpacity": 80,
              "gradientMode": "none",
              "axisPlacement": "auto",
              "axisLabel": "",
              "axisColorMode": "text",
              "scaleDistribution": {
                "type": "linear"
              },
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              },
              "thresholds": []
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Running"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#119600",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Pending"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#E5AC0E",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Failed"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#C4162A",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Succeeded"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#3788d8",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "targets": [
          {
            "expr": "sum(kube_pod_status_phase{phase=\"Running\"}) by (phase)",
            "legendFormat": "Running"
          },
          {
            "expr": "sum(kube_pod_status_phase{phase=\"Pending\"}) by (phase)",
            "legendFormat": "Pending"
          },
          {
            "expr": "sum(kube_pod_status_phase{phase=\"Failed\"}) by (phase)",
            "legendFormat": "Failed"
          },
          {
            "expr": "sum(kube_pod_status_phase{phase=\"Succeeded\"}) by (phase)",
            "legendFormat": "Succeeded"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Node CPU Usage",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Node Memory Usage",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "((node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes) * 100",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Node Disk Usage",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "((node_filesystem_size_bytes - node_filesystem_free_bytes) / node_filesystem_size_bytes) * 100",
            "legendFormat": "{{instance}} - {{mountpoint}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Node Disk I/O",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "rate(node_disk_io_time_seconds_total[1m]) * 100",
            "legendFormat": "{{instance}} - {{device}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Node Network Traffic",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
        "fieldConfig": {
          "defaults": {
            "unit": "Bps",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "RX"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#571EFA",
                    "mode": "fixed"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "TX"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#927AFA",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "targets": [
          {
            "expr": "rate(node_network_receive_bytes_total[1m])",
            "legendFormat": "RX - {{instance}}"
          },
          {
            "expr": "rate(node_network_transmit_bytes_total[1m])",
            "legendFormat": "TX - {{instance}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Pod Restarts (Last Hour)",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none"
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "topk(10, increase(kube_pod_container_status_restarts_total[1h]))",
            "legendFormat": "{{pod}} - {{container}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Deployment Replicas",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 52 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Desired"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#3788d8",
                    "mode": "fixed"
                  }
                },
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "dash": [10, 10],
                    "width": 2
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Available"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#119600",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "targets": [
          {
            "expr": "kube_deployment_spec_replicas",
            "legendFormat": "Desired - {{deployment}}"
          },
          {
            "expr": "kube_deployment_status_replicas_available",
            "legendFormat": "Available - {{deployment}}"
          }
        ]
      },
      {
        "type": "graph",
        "title": "StatefulSet Replicas",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 60 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Desired"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#3788d8",
                    "mode": "fixed"
                  }
                },
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "dash": [10, 10],
                    "width": 2
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Ready"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#119600",
                    "mode": "fixed"
                  }
                }
              ]
            }
          ]
        },
        "targets": [
          {
            "expr": "kube_statefulset_replicas",
            "legendFormat": "Desired - {{statefulset}}"
          },
          {
            "expr": "kube_statefulset_status_replicas_ready",
            "legendFormat": "Ready - {{statefulset}}"
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "current": {
            "selected": false,
            "text": "",
            "value": ""
          },
          "hide": 0,
          "includeAll": false,
          "multi": false,
          "name": "datasource",
          "options": [],
          "query": "prometheus",
          "queryValue": "",
          "refresh": 1,
          "regex": "",
          "skipUrlSync": false,
          "type": "datasource"
        },
        {
          "current": {
            "selected": false,
            "text": "All",
            "value": ".*"
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "definition": "label_values(kube_node_info, instance)",
          "hide": 0,
          "includeAll": true,
          "label": "Node",
          "multi": true,
          "name": "node",
          "options": [],
          "query": "label_values(kube_node_info, instance)",
          "refresh": 1,
          "regex": ".*",
          "skipUrlSync": false,
          "type": "query"
        },
        {
          "current": {
            "selected": false,
            "text": "All",
            "value": ".*"
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "definition": "label_values(kube_namespace_labels, namespace)",
          "hide": 0,
          "includeAll": true,
          "label": "Namespace",
          "multi": true,
          "name": "namespace",
          "options": [],
          "query": "label_values(kube_namespace_labels, namespace)",
          "refresh": 1,
          "regex": ".*",
          "skipUrlSync": false,
          "type": "query"
        }
      ]
    },
    "schemaVersion": 30,
    "style": "dark",
    "tags": ["opendesk", "kubernetes", "cluster"],
    "time": { "from": "now-1h", "to": "now" },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "timezone": "",
    "title": "Kubernetes Cluster Dashboard",
    "version": 1
  },
  "folderId": 0,
  "overwrite": true
}
