        "type": "stat",
        "title": "Cache Memory Usage",
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 12 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
