{
  "dashboard": {
    "id": null,
    "uid": "database-dashboard",
    "title": "Database & Cache Dashboard",
    "tags": ["opendesk", "mariadb", "memcached", "database"],
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "type": "text",
        "title": "Database & Cache Monitoring",
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
        "options": {
          "content": "<div style='background: linear-gradient(90deg, #0a0014 0%, #571EFA 50%, #927AFA 100%); padding: 20px; border-radius: 5px;'>\n  <h2 style='color: white; margin: 0; text-align: center;'>\n    <i class='fas fa-database' style='color: #DDD6FE; font-size: 40px; vertical-align: middle;'></i>\n    &nbsp; Database & Cache Services
  </h2>\n  <p style='color: #DDD6FE; margin: 10px 0 0 0; text-align: center; font-size: 14px;'>\n    MariaDB, Memcached, and Redis monitoring\n  </p>\n</div>",
          "mode": "html"
        }
      },
      {
        "type": "stat",
        "title": "MariaDB Status",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 4 },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": { "text": "Down", "color": "red" },
                  "1": { "text": "Up", "color": "green" }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "up{job=\"mariadb-exporter\"}",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Active Connections",
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 4 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 50 },
                { "color": "red", "value": 80 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "mysql_global_status_threads_connected",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Total Queries (5m)",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 4 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "rate(mysql_global_status_queries[5m])",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Connection Utilization",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 4 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 70 },
                { "color": "red", "value": 90 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "mariadb:connections:usage_percent",
            "instant": true
          }
        ]
      },
      {
        "type": "stat",
        "title": "Memcached Status",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 12 },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": { "text": "Down", "color": "red" },
                  "1": { "text": "Up", "color": "green" }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
