# Zot Registry HTPasswd File
# SPDX-License-Identifier: Apache-2.0
# Format: username:password (bcrypt hashed)
# Purpose: Authentication for Zot Registry
# Security Level: PRODUCTION
#
# This file contains bcrypt-hashed passwords for Zot Registry authentication.
# In production, these should be generated using:
#   htpasswd -B -c /etc/zot/passwd username
#
# NEVER commit plain text passwords to git.
# This file serves as a template with placeholder hashes.
#
# For Kubernetes deployment, this file should be mounted from a Secret.
#
# Example production htpasswd entries (REPLACE THESE IN PRODUCTION):
#
# admin:$2a$10$xJwL5v5z3b3J9JxJ3e3z5uQjR1lBn9pLq7z2Z3j5K8m1N2oP4q6R7
# cache-user:$2a$10$yJwL5v5z3b3J9JxJ3e3z5uQjR1lBn9pLq7z2Z3j5K8m1N2oP4q6R8
# ci-bot:$2a$10$zJwL5v5z3b3J9JxJ3e3z5uQjR1lBn9pLq7z2Z3j5K8m1N2oP4q6R9

# ============================================================================
# PRODUCTION USERS (bcrypt hashes - an example of how they look)
# ============================================================================
# Note: These are EXAMPLE hashes. In production, generate your own with:
#       htpasswd -B -c passwd admin
#       htpasswd -B passwd cache-user
#       htpasswd -B passwd ci-bot

# Admin user (full access)
# Format: username:bcrypt_hash
