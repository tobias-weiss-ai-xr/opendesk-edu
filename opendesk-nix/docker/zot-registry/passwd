# ============================================================================
# KUBERNETES INSTRUCTIONS
# ============================================================================
#
# To use this with Kubernetes, create a Secret:
#
#   kubectl create secret generic zot-htpasswd \
#     --from-file=htpasswd=./passwd \
#     -n opendesk
#
# Then mount it in your deployment:
#
#   volumes:
#     - name: htpasswd
#       secret:
#         secretName: zot-htpasswd
#         items:
#           - key: htpasswd
#             path: passwd
#
#   volumeMounts:
#     - name: htpasswd
#       mountPath: /etc/zot/passwd
#       subPath: passwd
#       readOnly: true
#
# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# 1. This is a TEMPLATE file. Do NOT use in production without
#    generating your own bcrypt hashes.
#
# 2. Use strong, unique passwords for each user.
#
# 3. Rotate passwords regularly (every 90 days for production).
#
# 4. For maximum security, use token authentication instead of
#    password-based authentication where possible.
#
# 5. Store this file with permissions 600 (owner read/write only).
#
# 6. In Kubernetes, mount as a read-only Secret.
#
# ============================================================================
