# EditorConfig for opendesk-nix
# Quality discipline ported from cibuilder-fork (stack4ops)

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{sh,bash}]
indent_size = 4

[*.nix]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[Makefile]
indent_style = tab
