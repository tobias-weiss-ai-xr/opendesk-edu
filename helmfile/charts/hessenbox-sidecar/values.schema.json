{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "hessenbox-sidecar",
  "description": "next.hessenbox storage sync sidecar configuration",
  "type": "object",
  "properties": {
    "image": {
      "title": "Container Image",
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "default": "rclone/rclone",
          "description": "rclone container image repository"
        },
        "tag": {
          "type": "string",
          "default": "latest",
          "description": "rclone image tag"
        },
        "pullPolicy": {
          "type": "string",
          "default": "IfNotPresent",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "hessenbox": {
      "title": "next.hessenbox Configuration",
      "type": "object",
      "required": ["username", "password"],
      "properties": {
        "url": {
          "type": "string",
          "default": "https://next.hessenbox.de/remote.php/dav",
          "description": "next.hessenbox WebDAV endpoint"
        },
        "username": {
          "type": "string",
          "description": "next.hessenbox username"
        },
        "password": {
          "type": "string",
          "description": "next.hessenbox password or app password"
        },
        "remotePath": {
          "type": "string",
          "default": "/",
          "description": "Remote path in next.hessenbox"
        },
        "syncInterval": {
          "type": "integer",
          "default": 60,
          "minimum": 10,
          "description": "Sync interval in seconds"
        },
        "bidirectional": {
          "type": "boolean",
          "default": true,
          "description": "Enable bidirectional sync"
        },
        "extraFlags": {
          "type": "string",
          "default": "--fast-list --verbose",
          "description": "Additional rclone flags"
        }
      }
    },
    "timezone": {
      "type": "string",
      "default": "Europe/Berlin",
      "description": "Timezone for the sidecar container"
    },
    "resources": {
      "title": "Resource Requirements",
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "default": "100m"
            },
            "memory": {
              "type": "string",
              "default": "128Mi"
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "default": "500m"
            },
            "memory": {
              "type": "string",
              "default": "512Mi"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
