---
# This file is the single place a cache and its credential are configured. A `password` carries the
# full value/create/name/key convention documented on `cassandra.rootPassword` in
# `secrets.yaml.gotmpl` only where something is handed the Secret rather than the value - the Redis
# chart and the migrations. The rest are value-only: their charts inline the password, so there is
# nothing to provision a Secret for and a `create`/`name`/`key` there would only suggest a Secret
# reference that no consumer makes.
#
# The per-component `password.value` entries are empty by default: an empty entry means "the
# bundled server's password", and every consumer falls back to `cache.redis.password.value` for it.
# Overriding only `cache.redis.password.value` therefore changes the password for the server and
# for every component using it. Pointing a component at an external cache means overriding its
# `host`/`port`/`username`/`tls` **and** its `password.value`; a non-empty component entry wins
# over the fallback in every consumer.

cache:
  redis:
    # The password the bundled Redis is deployed with, referenced by `auth.existingSecret` in the Redis chart.
    password:
      # A non-empty MASTER_PASSWORD is enforced in `secrets.yaml.gotmpl`, which every helmfile run
      # renders alongside this file.
      value: {{ derivePassword 1 "long" (env "MASTER_PASSWORD") "redis" "password" | sha1sum | quote }}
      create: true
      name: "redis-password"
      key: "redis-password"
  intercomService:
    host: "redis-headless"
    port: 6379
    # Username is currently being ignored by the Intercom Service Helm chart.
    # Ref.: https://forge.univention.org/bugzilla/show_bug.cgi?id=59490
    username: "default"
    # Read as a Secret by the `flush_intercom_sessions` migration and as a literal by the Intercom
    # Service chart, which has no `existingSecret` for it. The Secret below carries the *override*
    # only: while `value` is empty, the migration mounts the server's `redis-password` Secret
    # instead (see `opendesk-migrations-post/values.yaml.gotmpl`), so both stay a plain reflection
    # of what this file states.
    password:
      value: ""
      create: true
      name: "cache-intercom-service-password"
      key: "password"
    tls: false
  nextcloud:
    host: "redis-headless"
    port: 6379
    username: "default"
    # Value-only: the Nextcloud charts inline the password into their configuration.
    password:
      value: ""
    tls: false
  notes:
    host: "redis-headless"
    port: 6379
    username: "default"
    # Value-only: the Notes chart takes a connection URL with the password inlined.
    password:
      value: ""
    tls: false
  openproject:
    host: "memcached"
    port: 11211
  oxAppSuite:
    host: "redis-headless"
    port: 6379
    username: "default"
    # Value-only: OX App Suite inlines the password into its properties.
    password:
      value: ""
    tls: false
  umsSelfservice:
    host: "memcached"
    port: 11211
...
