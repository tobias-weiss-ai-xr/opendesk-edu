---
releases:
  - name: "open-webui"
    chart: "../../vendor/charts/open-webui"
    version: "3.0.6"
    values:
      - "values.yaml.gotmpl"
    installed: {{ .Values.apps.openWebui.enabled }}
    timeout: 600
commonLabels:
  deployStage: "050-components"
  component: "open-webui"
