---
releases:
  - name: "dask"
    chart: "../../vendor/charts/dask"
    version: "{{ .Values.charts.dask.version }}"
    values:
      - "values.yaml.gotmpl"
    installed: {{ .Values.apps.dask.enabled }}
    timeout: 600
commonLabels:
  deployStage: "050-components"
  component: "dask"
