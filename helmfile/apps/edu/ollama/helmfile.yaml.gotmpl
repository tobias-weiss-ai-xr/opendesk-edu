---
releases:
  - name: "ollama"
    chart: "../../vendor/charts/ollama"
    version: "0.68.0"
    values:
      - "values.yaml.gotmpl"
    installed: {{ .Values.apps.ollama.enabled }}
    timeout: 900
commonLabels:
  deployStage: "010-infra"
  component: "ollama"
