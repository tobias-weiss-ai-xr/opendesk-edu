---
# Image configuration (can override in values-static.yaml or environments)
image:
  repository: {{ .Values.images.paperless.repository | default "ghcr.io/paperless-ngx/paperless-ngx" }}
  tag: {{ .Values.images.paperless.tag | default "2.12.0" }}
  pullPolicy: "{{ .Values.images.paperless.pullPolicy | default "IfNotPresent" }}"

# Ingress configuration
ingress:
  enabled: true
  className: "haproxy"
  annotations:
    haproxy-ingress.github.io/ssl-redirect: "true"
    haproxy-ingress.github.io/proxy-body-size: "200M"
    haproxy-ingress.github.io/timeout-server: "600s"
    haproxy-ingress.github.io/timeout-client: "600s"
    {{- with .Values.annotations.paperless.ingress }}
    {{- toYaml . | nindent 4 }}
    {{- end }}
  hosts:
    - host: {{ printf "%s.%s" .Values.global.hosts.paperless .Values.global.domain | quote }}
      paths:
        - path: /
          pathType: ImplementationSpecific
  tls:
    - secretName: "opendesk-certificates-tls"
      hosts:
        - {{ printf "%s.%s" .Values.global.hosts.paperless .Values.global.domain | quote }}

# Paperless-ngx specific configuration
paperless:
  # Secret key - generate if not provided
  secretKey: {{ .Values.secrets.paperless.secretKey | default (randAlphaNum 64) | quote }}
  
  # Admin user (will be created on first run)
  admin:
    username: {{ .Values.secrets.paperless.adminUsername | default "admin" | quote }}
    password: {{ .Values.secrets.paperless.adminPassword | default "" | quote }}
    email: "admin@{{ .Values.global.domain }}"
  
  # OIDC authentication
  oidc:
    enabled: true
    issuer: {{ printf "https://id.%s/realms/%s" .Values.global.domain .Values.platform.realm | quote }}
    clientId: "paperless-ngx"
    clientSecret: {{ .Values.secrets.paperless.oidcClientSecret | default "" | quote }}
    existingSecret: "paperless-ngx-oidc-secrets"
    existingSecretClientSecretKey: "oidc-client-secret"
    signAlgorithm: "RS256"
    scopes: "openid email profile"
    usernameClaim: "preferred_username"
    emailClaim: "email"
    firstNameClaim: "given_name"
    lastNameClaim: "family_name"
  
  # Database configuration
  database:
    host: "paperless-ngx-postgresql"
    port: 5432
    name: "paperless"
    user: "paperless"
    password: ""
    existingSecret: "paperless-ngx-database-secrets"
    existingSecretPasswordKey: "postgresql-password"
  
  # Redis configuration
  redis:
    host: "paperless-ngx-redis-master"
    port: 6379
    password: ""
    existingSecret: "paperless-ngx-redis-secrets"
    existingSecretPasswordKey: "redis-password"
  
  # OCR configuration
  ocr:
    enabled: true
    language: "eng+deu+fra"
    imageDpi: 300
    rotatePages: true
  
  # Tesseract configuration
  tesseract:
    enabled: true
    languages: "eng+deu+fra+ita+spa+por+nld"  # Common academic languages
  
  # Consumption configuration
  consume:
    enabled: true
    pollInterval: 60
    recursive: true
    barcode:
      enabled: true
      base64: false
  
  # Email consumption (via Stalwart)
  email:
    enabled: true
    imap:
      enabled: true
      host: "stalwart-stalwart.opendesk.svc.cluster.local"
      port: 993
      ssl: true
      username: ""
      password: ""
      existingSecret: "paperless-ngx-email-secrets"
      mailbox: "INBOX"
      readOnly: false
  
  # AI configuration (optional)
  ai:
    enabled: false
    # model: "sentence-transformers/all-MiniLM-L6-v2"

# Persistence configuration
persistence:
  enabled: true
  data:
    enabled: true
    size: {{ .Values.apps.paperlessNgx.storage.dataSize | default "100Gi" | quote }}
    storageClass: {{ .Values.storageclasses.cephfs | default "ceph-cephfs-hdd-ec" | quote }}
    accessMode: ReadWriteMany
    annotations: {}
  consume:
    enabled: true
    size: {{ .Values.apps.paperlessNgx.storage.consumeSize | default "50Gi" | quote }}
    storageClass: {{ .Values.storageclasses.cephfs | default "ceph-cephfs-hdd-ec" | quote }}
    accessMode: ReadWriteMany
    annotations: {}

# Resource configuration
resources:
  {{- toYaml .Values.resources.paperless | nindent 2 }}

# PostgreSQL configuration (sub-chart)
postgresql:
  enabled: true
  auth:
    postgresPassword: {{ .Values.secrets.paperless.postgresPassword | default (randAlphaNum 32) | quote }}
    username: "paperless"
    password: {{ .Values.secrets.paperless.databasePassword | default (randAlphaNum 32) | quote }}
    database: "paperless"
    existingSecret: "paperless-ngx-database-secrets"
  primary:
    persistence:
      enabled: true
      size: {{ .Values.apps.paperlessNgx.storage.databaseSize | default "20Gi" | quote }}
      storageClass: {{ .Values.storageclasses.cephRbdSsd | default "ceph-rbd-ssd" | quote }}
      accessModes:
        - ReadWriteOnce
    resources:
      {{- toYaml .Values.resources.paperlessPostgresql | nindent 6 }}

# Redis configuration (sub-chart)
redis:
  enabled: true
  auth:
    enabled: true
    password: {{ .Values.secrets.paperless.redisPassword | default (randAlphaNum 32) | quote }}
    existingSecret: "paperless-ngx-redis-secrets"
  primary:
    persistence:
      enabled: true
      size: {{ .Values.apps.paperlessNgx.storage.redisSize | default "5Gi" | quote }}
      storageClass: {{ .Values.storageclasses.cephRbdSsd | default "ceph-rbd-ssd" | quote }}
    resources:
      {{- toYaml .Values.resources.paperlessRedis | nindent 6 }}

# Backup configuration
backup:
  enabled: {{ .Values.backup.paperless.enabled | default true }}
  k8up:
    schedule: {{ .Values.backup.paperless.schedule | default "0 2 * * *" | quote }}
    retention:
      daily: {{ .Values.backup.paperless.retention.daily | default 7 }}
      weekly: {{ .Values.backup.paperless.retention.weekly | default 4 }}
      monthly: {{ .Values.backup.paperless.retention.monthly | default 3 }}
    snapshotVolumes: true

# Autoscaling configuration
autoscaling:
  enabled: {{ .Values.apps.paperlessNgx.autoscaling.enabled | default false }}
  minReplicas: {{ .Values.apps.paperlessNgx.autoscaling.minReplicas | default 1 }}
  maxReplicas: {{ .Values.apps.paperlessNgx.autoscaling.maxReplicas | default 3 }}
  targetCPUUtilizationPercentage: {{ .Values.apps.paperlessNgx.autoscaling.targetCPU | default 80 }}
  targetMemoryUtilizationPercentage: {{ .Values.apps.paperlessNgx.autoscaling.targetMemory | default 80 }}

# Pod Disruption Budget
pdb:
  enabled: true
  minAvailable: 1

# Network policies
networkPolicies:
  enabled: {{ .Values.apps.paperlessNgx.networkPolicies.enabled | default true }}
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              name: opendesk
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: haproxy-ingress
      ports:
        - port: 8000
          protocol: TCP

# Common annotations
commonAnnotations:
  {{- with .Values.annotations.paperless.common }}
  {{- toYaml . | nindent 2 }}
  {{- end }}

# Service annotations
service:
  annotations:
    {{- with .Values.annotations.paperless.service }}
    {{- toYaml . | nindent 4 }}
    {{- end }}

# Service account annotations
serviceAccount:
  annotations:
    {{- with .Values.annotations.paperless.serviceAccount }}
    {{- toYaml . | nindent 4 }}
    {{- end }}

# Node selector
nodeSelector: {}

# Tolerations
tolerations: []

# Affinity
affinity: {}

# Host aliases for HRZ DNS issues
hostAliases:
  - ip: "192.168.3.201"
    hostnames:
      - "id.{{ .Values.global.domain }}"
      - "files.{{ .Values.global.domain }}"
      - "portal.{{ .Values.global.domain }}"
