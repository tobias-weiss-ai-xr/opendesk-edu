---
releases:
  - name: {{ .Values.eudiIssuer.releaseName | default "eudi-issuer" }}
    chart: "../../../charts/eudi-issuer"
    version: 0.1.0
    wait: true
    values:
      - "values.yaml.gotmpl"
    installed: {{ .Values.apps.eudiIssuer.enabled | default false }}
    timeout: 600

commonLabels:
  deployStage: "060-addon"
  component: eudi-issuer
