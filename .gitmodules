# Git submodule configuration for opendesk_git
# Source of truth: Use GitHub forks (tobias-weiss-ai-xr) as primary URLs
# HRZ GitLab repos are used for internal deployment

# ============================================================================
# Core OpenDesk Components (HRZ GitLab)
# ============================================================================

[submodule "opendesk"]
	path = opendesk
	url = git@gitlab.hrz.uni-marburg.de:hrz/kubernetes/opendesk/opendesk.git

[submodule "argocd-opendesk"]
	path = argocd-opendesk
	url = git@gitlab.hrz.uni-marburg.de:hrz/kubernetes/argocd/opendesk.git

[submodule "erprobungskonzept"]
	path = erprobungskonzept
	url = git@gitlab.hrz.uni-marburg.de:hrz/kubernetes/opendesk/erprobungskonzept.git

[submodule "k8s-mc-mirror"]
	path = k8s-mc-mirror
	url = git@gitlab.hrz.uni-marburg.de:hrz/kubernetes/opendesk/k8s-mc-mirror.git

[submodule "k8up"]
	path = k8up
	url = git@gitlab.hrz.uni-marburg.de:hrz/kubernetes/opendesk/k8up.git

[submodule "monitoring"]
	path = monitoring
	url = git@gitlab.hrz.uni-marburg.de:hrz/kubernetes/opendesk/monitoring.git

[submodule "registry"]
	path = registry
	url = git@gitlab.hrz.uni-marburg.de:hrz/kubernetes/opendesk/registry.git

[submodule "user_import"]
	path = user_import
	url = git@gitlab.hrz.uni-marburg.de:hrz/kubernetes/opendesk/user-import.git

